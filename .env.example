# ==============================================================================
# DataBridge 환경 설정
# ==============================================================================
# 이 파일을 .env로 복사한 후 운영 환경에 맞게 수정하세요.
# 보안 관련 항목(PASSWORD, SECRET_KEY 등)은 반드시 변경해야 합니다.
#
# 자세한 설정 가이드: docs/DEPLOYMENT.md
# ==============================================================================

# === 감시할 폴더 ===
# WATCH_DIR_HOST: Docker 볼륨 마운트용 (호스트 OS 경로)
#   - Linux 예시: /mnt/nas/shared_data
#   - Windows 예시: C:/SharedData (백슬래시 대신 슬래시 사용)
# WATCH_DIR: 컨테이너 내부 경로 (변경 불필요)
WATCH_DIR_HOST=/mnt/shared/data
WATCH_DIR=/data

# === DB ===
POSTGRES_DB=databridge
POSTGRES_USER=admin
# [!] 운영환경 필수 변경: 강력한 비밀번호 사용 (12자 이상, 특수문자 포함)
POSTGRES_PASSWORD=admin1234
POSTGRES_PORT=5432

# === ChromaDB ===
CHROMA_PORT=8000

# === AI 모델 (Ollama — 로컬 설치 필요: https://ollama.com/download) ===
OLLAMA_HOST=http://host.docker.internal:11434 
OLLAMA_PORT=11434
LLM_MODEL=exaone3.5:7.8b
# LLM 응답 타임아웃 (초). CPU 환경에서는 120초 이상 권장
LLM_TIMEOUT=120

# === 에이전트 ===
AGENT_MAX_QUERY_ROWS=5000
AGENT_QUERY_TIMEOUT=30

# === 마트/배치 ===
MART_PREFIX=mart_
JOB_LOG_DIR=./logs/jobs

# === 문서 처리 ===
# 임베딩 최대 파일 크기 (MB). 이 크기 초과 시 Lazy Loading 적용
# (카탈로그 등록만 하고, 질의 시 온디맨드로 파싱)
MAX_EMBED_SIZE_MB=10.0

# === Webhook API ===
WEBHOOK_ENABLED=true
# [!] 운영환경 필수 변경: openssl rand -hex 16 으로 생성
WEBHOOK_SECRET=changeme

# === 인증 ===
# [!] 운영환경 필수 변경: 관리자 초기 비밀번호 (12자 이상, 특수문자 포함)
ADMIN_PASSWORD=admin1234
# [!] 운영환경 필수 변경: openssl rand -hex 32 으로 생성
SECRET_KEY=databridge-secret-key-change-me

# === 앱 포트 ===
APP_PORT=8501

# === 외부 DB 연결 (선택) ===
# EXTERNAL_DB_TYPE=mysql
# EXTERNAL_DB_HOST=192.168.1.100
# EXTERNAL_DB_PORT=3306
# EXTERNAL_DB_NAME=company_db
# EXTERNAL_DB_USER=readonly_user
# EXTERNAL_DB_PASSWORD=xxxxx
